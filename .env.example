# Copy to .env and fill in your own values. Never commit .env.

# Hugging Face token — required to download Llama / Qwen base models.
# https://huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN="hf_..."

# Weights & Biases — experiment tracking (optional, set USE_WANDB in params.py).
# https://wandb.ai/authorize
WANDB_API_KEY="..."

# Groq API key — used to generate judge training data (LLM-as-judge scores).
# https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Best adapter names, referenced by the helper shell scripts.
BEST_GEN='Llama-3.2-1B-Instruct-opensubtitles-10ep-..._best_ep2'
BEST_JUDGE='Qwen2.5-3B-Instruct-judge-3ep-..._final'

# Remote GPU (e.g. Vast.ai) connection for cloud training — see docs/VAST_AI_SETUP.md
VM_HOST=1.2.3.4
VM_PORT=22
VM_USER=root
